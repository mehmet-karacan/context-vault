# Kopyala: cp .env.example .env — sonra kendi değerlerini gir. .env gitignore'da, commit edilmez.

LITELLM_API_KEY=your-gateway-api-key
LITELLM_BASE_URL=https://llm-gateway.example.invalid/v1
EMBEDDING_MODEL=openai/BAAI/bge-m3
CHAT_MODEL=moonshotai/Kimi-K2.7-Code
CHAT_MODELS=moonshotai/Kimi-K2.7-Code,Qwen/Qwen3.5-27B-FP8

APP_ENV=local
# Docker must listen on its container interface. Because this is not loopback,
# AUTH_MODE=disabled is intentionally rejected; use api_key for compose.
BIND_HOST=0.0.0.0
AUTH_MODE=api_key
API_KEY_PEPPER=replace-with-at-least-32-random-characters
CORS_ALLOW_ORIGINS=http://localhost:3000

POSTGRES_DB=context_vault
POSTGRES_USER=context_vault_app
POSTGRES_PASSWORD=replace-with-a-unique-database-password

MINIO_ROOT_USER=context_vault_storage
MINIO_ROOT_PASSWORD=replace-with-a-unique-storage-password
MINIO_BUCKET=context-vault

RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=redis

# Remote repository ingestion is deny-by-default. When explicitly enabled,
# hosts must be exact comma-separated names; IP literals and private DNS
# results remain forbidden.
FEATURE_REPOSITORY_INGESTION=false
REPOSITORY_ALLOWED_HOSTS=github.com

# Aşama 2.4: upload endpoint queues an IngestionJob and returns immediately
# instead of blocking on parse+chunk+embed. Set to false only temporarily
# (e.g. rollback/debug) to restore the old fully-synchronous upload path.
FEATURE_ASYNC_INGESTION=true
