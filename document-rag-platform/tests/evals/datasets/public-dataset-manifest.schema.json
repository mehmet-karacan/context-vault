{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-vault.local/schemas/public-eval-dataset-manifest-v1.json",
  "title": "Public synthetic evaluation dataset review manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_version", "dataset_sha256", "records",
    "classification", "reviewer", "review_status", "reviewed_at_utc",
    "review_receipt_sha256", "splits", "fixture_independence",
    "private_equivalent"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "dataset_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "records": {"type": "integer", "minimum": 1},
    "classification": {"const": "public-synthetic"},
    "reviewer": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "review_status": {"enum": ["pending", "approved"]},
    "reviewed_at_utc": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "date-time"}
      ]
    },
    "review_receipt_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "splits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"}
    },
    "fixture_independence": {"type": "string", "minLength": 1, "maxLength": 500},
    "private_equivalent": {"const": "private-pack-manifest.schema.json"}
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "pending"}}},
      "then": {
        "properties": {
          "reviewer": {"const": "PENDING_OWNER_REVIEW"},
          "reviewed_at_utc": {"type": "null"},
          "review_receipt_sha256": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "reviewed_at_utc": {"type": "string", "format": "date-time"},
          "review_receipt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  ]
}
