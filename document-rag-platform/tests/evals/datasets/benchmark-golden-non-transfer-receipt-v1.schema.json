{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-vault.local/schemas/benchmark-golden-non-transfer-receipt-v1.json",
  "title": "Independent golden-data non-transfer review receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "receipt_type", "receipt_id", "decision",
    "verified_by", "verified_at_utc", "verification_method",
    "verification_evidence_sha256", "verified_request_count",
    "repository_revision", "runner_bundle_sha256",
    "private_pack_manifest_sha256", "dataset_sha256",
    "golden_dataset_sha256", "execution_dataset_sha256",
    "execution_projection_sha256", "report_sha256", "environment_hash",
    "embedding_provider", "embedding_model",
    "generation_provider", "generation_model"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "receipt_type": {"const": "golden-non-transfer-independent-review"},
    "receipt_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "decision": {"const": "verified-no-golden-transfer"},
    "verified_by": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "verified_at_utc": {"type": "string", "format": "date-time"},
    "verification_method": {
      "enum": [
        "independent-request-capture",
        "independent-egress-observation",
        "provider-audit-log"
      ]
    },
    "verification_evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "verified_request_count": {"type": "integer", "minimum": 1, "maximum": 1000000},
    "repository_revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "runner_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "private_pack_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "golden_dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "execution_projection_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "report_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "embedding_provider": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "embedding_model": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "generation_provider": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "generation_model": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"}
  }
}
