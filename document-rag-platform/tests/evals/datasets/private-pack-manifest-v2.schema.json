{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://context-vault.local/schemas/private-eval-pack-manifest-v2.json",
  "title": "Owner-reviewed private evaluation pack manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "opaque_pack_id", "dataset_sha256", "classification",
    "review_status", "reviewed_by", "approved_at_utc", "records", "query_types"
  ],
  "properties": {
    "schema_version": {"const": "2.0"},
    "opaque_pack_id": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "classification": {"enum": ["internal", "confidential", "restricted"]},
    "review_status": {"const": "approved"},
    "reviewed_by": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"},
    "approved_at_utc": {"type": "string", "format": "date-time"},
    "records": {"type": "integer", "minimum": 1},
    "query_types": {
      "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"}
    },
    "secret_store_reference": {"type": "string"}
  }
}
